# Optional benchmark settings for standalone mode.
# URL parameters take precedence: ?delegate=cpu  ?stats=1

# MediaPipe delegate: GPU (WebGL, default; falls back to CPU) or CPU (WASM, forced)
VITE_HAND_DELEGATE=

# Show the delegate / inference time / fps readout (always on in `pnpm dev`)
VITE_PERF_STATS=
